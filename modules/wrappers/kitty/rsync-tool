#!/usr/bin/env bash
set -euo pipefail

function wait_confirm {
  # shellcheck disable=2162
  read -p $'HAS ERROR!\nPress any key to exit... \n' -n1 -s
}

trap wait_confirm ERR

PORT=""
HOST=""
FILES=()
ACTION=""

die() {
  builtin echo "$*" >&2
  exit 1
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
    --action)
      shift
      ACTION="$1"
      ;;
    --port)
      shift
      PORT="$1"
      ;;
    --host)
      shift
      HOST="$1"
      ;;
    --)
      shift
      FILES=("$@")
      break
      ;;
    *)
      die "unknown arg: '$1'"
      ;;
    esac
    shift
  done
}

select_local_dir() {
  local dir
  dir="$(yazi --chooser-file /dev/stdout)"
  if [ -z "$dir" ]; then
    die "no dir selected"
  fi
  if [ -f "$dir" ]; then
    dir="${dir%/*}"
  fi
  echo "$dir"
}

reveal() {
  if [ -n "${YAZI_ID:-}" ]; then
    ya emit reveal "$1"
  else
    yazi "$1"
    # fish -i -C "r '$1'"
  fi
}

reveal_remote() {
  # ssh "fish -i -C 'r \"$1\"'"
  ssh "yazi '$1'"
}

rsync() {
  local rsync_ssh=()
  if [ -n "$PORT" ]; then
    rsync_ssh+=("-e")
    rsync_ssh+=("ssh -p $PORT")
  fi
  command rsync --verbose --human-readable --progress --recursive --partial --exclude=.git "${rsync_ssh[@]}" "$@"
}

ssh() {
  local ssh_port=""
  if [ -n "$PORT" ]; then
    ssh_port="-p $PORT"
  fi
  # shellcheck disable=2086
  command ssh -t $ssh_port "$HOST" "$@"
}

# push 时远端是 receiver，rsync >= 3.5.0 才认识 --insecure-links：
# 3.5.0 把非 daemon receiver 的目标目录 chdir 改成「逐段
# openat(O_RDONLY|O_DIRECTORY) 再 fchdir」的 ownership walk
# （CVE-2026-53796），于是每级父目录都需要可读。Android 的 /data、
# /data/data 是 0771（只有 x 没有 r），会直接 EACCES 并报
# `change_dir#1 ... Permission denied`。该选项是 local-only、不会被
# 转发给远端，只能通过 --rsync-path 让远端进程自己带上；老版本 rsync
# 不认识这个 flag，所以先探一下版本，< 3.5.0 时保持原样。
remote_supports_insecure_links() {
  local out version major minor
  local ssh_port=()
  if [ -n "$PORT" ]; then
    ssh_port=(-p "$PORT")
  fi
  # 这里不能走上面的 ssh()：带 -t 会让远端跑交互式 shell，输出不干净
  out=$(command ssh "${ssh_port[@]}" "$HOST" 'rsync --version 2>/dev/null | head -n1') || return 1
  version=${out#*version }         # "3.5.0  protocol version 32"
  version=${version%%[!0-9.]*}     # "3.5.0"
  major=${version%%.*}
  minor=${version#*.}
  minor=${minor%%.*}
  case "${major}${minor}" in
  '' | *[!0-9]*) return 1 ;;
  esac
  [ "$major" -gt 3 ] || { [ "$major" -eq 3 ] && [ "$minor" -ge 5 ]; }
}

pull() {
  if [[ "$#" -lt 2 ]]; then
    die "pull need at least 2 args, but got $#"
  fi
  local rsync_src=("${HOST}:$1")
  shift
  while [ "$#" -gt 1 ]; do
    rsync_src+=(":$1")
    shift
  done
  local local_dst="$1"
  rsync "${rsync_src[@]}" "${local_dst}"
}

push() {
  if [[ "$#" -lt 2 ]]; then
    die "push need at least 2 args, but got $#"
  fi
  local local_src=()
  while [ "$#" -gt 1 ]; do
    local_src+=("$1")
    shift
  done

  local remote_dst="${HOST}:$1"
  local opt=()
  if remote_supports_insecure_links; then
    opt=(--rsync-path 'rsync --insecure-links')
  fi

  if [[ "${local_src[0]}" == /* ]]; then
    rsync "${opt[@]}" "${local_src[@]}" "$remote_dst"
  else
    rsync --relative "${opt[@]}" "${local_src[@]}" "$remote_dst"
  fi
}

main() {
  case "$ACTION" in
  pull)
    local local_dir
    local_dir="$(select_local_dir "Select which local directory to save remote files")"
    pull "${FILES[@]}" "$local_dir"
    local first="${FILES[0]}"
    reveal "${local_dir}/${first##*/}"
    ;;
  push)
    if [ ${#FILES[@]} -ne 1 ]; then
      die "remote dir count is ${#FILES[@]}, must be 1"
    fi
    local remote_dir="${FILES[0]}"
    if IFS=$'\n' read -d '' -r -a local_files; then :; fi < <(yazi --chooser-file /dev/stdout)
    push "${local_files[@]}" "${remote_dir}"
    local first=${local_files[0]}
    # reveal_remote "${remote_dir}/${first##*/}"
    ;;
  *)
    echo default
    ;;
  esac
}

parse_args "$@"
main
